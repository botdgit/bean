# Supabase (mobile app reads these via EXPO_PUBLIC_*)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Stripe (mobile app reads publishable key only)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.com.bean.app

# Server-only secrets (set in Supabase Edge Function secrets, never committed)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# SQUARE_APPLICATION_ID=xxx
# SQUARE_APPLICATION_SECRET=xxx
# SQUARE_WEBHOOK_SIGNATURE_KEY=xxx
# EXPO_ACCESS_TOKEN=xxx  # for sending push notifications
